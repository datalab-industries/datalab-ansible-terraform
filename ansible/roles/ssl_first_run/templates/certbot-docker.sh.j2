#!/bin/sh
certbot certonly --webroot -w /var/www/certbot --expand --register-unsafely-without-email --no-eff-email --agree-tos -d {{ app_host }}{% if api_host != app_host %} -d {{ api_host }}{% endif %}{% if extras is defined and extras %}{% for extra, extra_config in extras.items() %} -d {{ extra_config.url }}{% endfor %}{% endif %}
