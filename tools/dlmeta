# --- Batch commands ----------------------------------------------------------------------


_ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
_ANSIBLE_TASK = re.compile(r"(?:TASK|RUNNING HANDLER) \[(.*)\] \*")
_ANSIBLE_RECAP = re.compile(r"ok=(\d+)\s+changed=(\d+)\s+unreachable=(\d+)\s+failed=(\d+)")


class BatchRun:
    """One deployment's part of a `dlmeta run`: its process, its log and what its output says so far."""

    def __init__(self, repo: Path, command: list[str], log: Path, skip_reason: str | None = None) -> None:
        self.repo, self.command, self.log, self.skip_reason = repo, command, log, skip_reason
        self.name = repo.name
        self.status = "skipped" if skip_reason else "queued"
        self.code: int | None = None
        self.started: float | None = None
        self.finished: float | None = None
        self.task: str | None = None
        self.failed_task: str | None = None
        self.recap: list[int] | None = None
        self.proc: subprocess.Popen | None = None

    @property
    def settled(self) -> bool:
        return self.status not in ("queued", "running")

    @property
    def elapsed(self) -> float:
        return ((self.finished or time.monotonic()) - self.started) if self.started else 0.0

    @property
    def recap_text(self) -> str:
        if not self.recap:
            return ""
        ok, changed, unreachable, failed = self.recap
        return f"ok={ok} changed={changed} failed={failed + unreachable}"

    def outcome(self) -> str:
        if self.status == "skipped":
            return f"skipped: {self.skip_reason}"
        if self.status in ("queued", "not run"):
            return "not run"
        details = ", ".join(filter(None, (f"{self.elapsed:.0f}s", self.recap_text)))
        if self.status == "ok":
            return f"ok ({details})"
        at = f", at task: {self.failed_task}" if self.failed_task else ""
        return f"FAILED with exit code {self.code} ({details}){at}"

    def _parse(self, line: str) -> None:
        line = _ANSI.sub("", line)
        if m := _ANSIBLE_TASK.match(line):
            self.task = m[1]
        elif line.startswith(("fatal: [", "failed: [")):
            # May yet be ignored or rescued, so only reported if the run goes on to fail
            self.failed_task = self.task
        elif m := _ANSIBLE_RECAP.search(line):
            counts = [int(n) for n in m.groups()]
            self.recap = [a + b for a, b in zip(self.recap, counts)] if self.recap else counts

    def execute(self, on_line=None) -> None:
        """Run the command in its own session, writing its output to the log and passing each line
        to on_line(run, str). Having no terminal, it can't draw over the TUI or wait on a prompt.
        """
        env = _repo_env()
        env["ANSIBLE_FORCE_COLOR"] = "1"
        self.status, self.started = "running", time.monotonic()
        partial = b""

        def line_out(raw: bytes) -> None:
            line = raw.decode(errors="replace").rstrip("\r")
            self._parse(line)
            if on_line:
                on_line(self, line)

        with self.log.open("wb", buffering=0) as out:
            def output(chunk: bytes) -> None:
                nonlocal partial
                out.write(chunk)
                *lines, partial = (partial + chunk).split(b"\n")
                for raw in lines:
                    line_out(raw)

            try:
                self.proc = subprocess.Popen(self.command, cwd=self.repo, env=env, stdin=subprocess.DEVNULL,
                                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                             start_new_session=True)
            except OSError as exc:
                output(f"{exc}\n".encode())
                self.code = 127
            else:
                fd = self.proc.stdout.fileno()
                while True:
                    if select.select([fd], [], [], 0.5)[0]:
                        chunk = os.read(fd, 4096)
                        if not chunk:
                            break
                        output(chunk)
                    # A background process left behind can hold the pipe open long after the command ended
                    elif self.proc.poll() is not None:
                        break
                self.code = self.proc.wait()
            if partial:
                line_out(partial)
        self.finished = time.monotonic()
        self.status = "ok" if self.code == 0 else "failed"

    def interrupt(self, sig: int = signal.SIGINT) -> None:
        """Signal the run's whole process group (make, uv, ansible and its ssh sessions)."""
        if self.proc and self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, sig)
            except ProcessLookupError:
                pass


def _execute_batch(runs: list[BatchRun], stop: threading.Event, on_line=None, on_finish=None) -> bool:
    """Run everything not skipped, RUN_JOBS at a time, until `stop` is set. A failure doesn't stop
    the others, as deployments are independent. Returns whether it was interrupted."""

    def run_one(run: BatchRun) -> None:
        if stop.is_set():
            run.status = "not run"
            return
        run.execute(on_line)
        if on_finish:
            on_finish(run)

    interrupted = False
    pool = concurrent.futures.ThreadPoolExecutor(max_workers=RUN_JOBS)
    try:
        for future in concurrent.futures.as_completed([pool.submit(run_one, r) for r in runs if not r.settled]):
            future.result()
    except KeyboardInterrupt:
        interrupted = True
        stop.set()
        for run in runs:
            run.interrupt()
    pool.shutdown(wait=True, cancel_futures=True)
    return interrupted


def _duration(text: str) -> int:
    """Seconds in a duration such as 30m, 12h, 1d or 1w, or 0."""
    if text == "0":
        return 0
    m = re.fullmatch(r"(\d+)([mhdw])", text)
    if not m:
        raise argparse.ArgumentTypeError(f"{text!r} is not a duration, e.g. 30m, 12h, 1d, 1w or 0")
    return int(m[1]) * {"m": 60, "h": 3600, "d": 86400, "w": 604800}[m[2]]


def _last_success(runs: list[dict], target: str) -> str | None:
    """When a make target last succeeded, which a whole-playbook run also counts as (runs are oldest first)."""
    matching = [r["started"] for r in runs if r["status"] == "success" and r.get("started")
                and {target, "all"} & set(r.get("tags") or ["all"])]
    return matching[-1] if matching else None


def _skip_reason(repo: Path, command: list[str], ledger: dict[str, list[dict]], rerun_after: int | None) -> str | None:
    if command[0] != "make":
        return None
    if not (repo / "Makefile").is_file():
        return "no Makefile"
    targets = [arg for arg in command[1:] if not arg.startswith("-")] or ["all"]
    # Maintenance upgrades packages and can restart Docker, so is not worth repeating. Anything else
    # may well be run again on purpose, e.g., a deploy after bumping the version or changing config.
    if rerun_after is None:
        rerun_after = MAINTENANCE_RERUN_AFTER if targets == ["maintenance"] else 0
    if not rerun_after:
        return None
    last = [_last_success(ledger.get(repo.name, []), target) for target in targets]
    now = datetime.datetime.now(datetime.timezone.utc)
    if all(last) and all((now - datetime.datetime.fromisoformat(ts)).total_seconds() < rerun_after for ts in last):
        return f"{' '.join(targets)} succeeded {_ago(min(last))}"
    return None


def cmd_run(args) -> None:
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        sys.exit("dlmeta: no command given, e.g. `dlmeta run -- make maintenance`")
    if args.rerun_after and command[0] != "make":
        sys.exit("dlmeta: --rerun-after only works with make targets, which is how runs are matched to the ledger")
    repos = select_repos(args.only, args.exclude, args.all)
    if not repos:
        sys.exit("dlmeta: no deployments selected")

    uses_ansible = command[0] == "make" or "ansible" in " ".join(command)
    ledger = load_runs()
    targets, skipped = [], {}
    print(f"Command: {' '.join(command)}")
    for repo in repos:
        dirty = len((_git(repo, "status", "--porcelain") or "").splitlines())
        reason = _skip_reason(repo, command, ledger, args.rerun_after)
        if reason:
            skipped[repo.name] = reason
        else:
            targets.append(repo)
        note = f"skip: {reason}" if reason else f"{dirty} uncommitted" if dirty else ""
        print(f"  {repo.name:<40} {note}")
    if uses_ansible and not LEDGER_PLUGIN.is_file() and LEDGER_PLUGIN.stem not in os.environ.get("ANSIBLE_CALLBACKS_ENABLED", ""):
        print(f"Warning: {LEDGER_PLUGIN} not found, so these runs may not be recorded in the ledger")
    if args.dry_run or not targets:
        return
    if not args.yes:
        if not sys.stdin.isatty():
            sys.exit("dlmeta: refusing to run without confirmation, pass --yes")
        if input(f"Run in {len(targets)} deployment(s), up to {RUN_JOBS} at a time? [y/N] ").strip().lower() != "y":
            return

    sys.stdout.flush()
    if uses_ansible:
        ensure_rbw()
    # Output of ansible can include secrets
    LOGS.mkdir(parents=True, mode=0o700, exist_ok=True)
    log_dir = LOGS / f"{datetime.datetime.now(datetime.timezone.utc):%Y%m%dT%H%M%SZ}-{os.getpid()}"
    log_dir.mkdir(mode=0o700)
    runs = [BatchRun(repo, command, log_dir / f"{repo.name}.log", skipped.get(repo.name)) for repo in repos]
    stop = threading.Event()
    if sys.stdout.isatty():
        try:
            interrupted = _batch_app(runs, stop).run()
        finally:
            # Only anything left if the TUI itself failed
            for run in runs:
                run.interrupt(signal.SIGTERM)
    else:
        interrupted = _execute_batch(runs, stop, on_finish=lambda run: print(f"{run.name}: {run.outcome()}", flush=True))

    print(f"\nSummary (logs in {log_dir}):")
    for run in runs:
        print(f"  {run.name:<40} {run.outcome()}")
    if interrupted:
        sys.exit(130)
    if any(run.status == "failed" for run in runs):
        sys.exit(1)


def _batch_app(runs: list[BatchRun], stop: threading.Event):
    """A summary tab plus a tab streaming each deployment's output. Returns whether it was interrupted."""
    from rich.text import Text
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.widgets import DataTable, Footer, Header, RichLog, TabbedContent, TabPane, Tabs

    ICONS = {"queued": "…", "running": "▶", "ok": "✓", "failed": "✗", "not run": "–", "skipped": "–"}
    STYLES = {"queued": "dim", "running": "bold cyan", "ok": "green", "failed": "bold red", "not run": "dim", "skipped": "dim"}
    COLUMNS = ["Deployment", "Status", "Time", "Task", "Recap"]
    QUIT_CONFIRM_SECONDS = 5
    tabs = {f"run-{i}": run for i, run in enumerate(runs) if run.status != "skipped"}

    class BatchApp(App[bool]):
        TITLE = "dlmeta run"
        ENABLE_COMMAND_PALETTE = False
        CSS = TABLE_CSS + "DataTable, RichLog { height: 1fr; } TabPane { padding: 0; }"
        BINDINGS = [
            Binding("n", "next_tab", "Next tab"),
            Binding("p", "previous_tab", "Previous tab"),
            Binding("s", "summary", "Summary"),
            Binding("x", "drain", "Start no more"),
            Binding("q", "quit", "Quit"),
        ]

        def __init__(self) -> None:
            super().__init__()
            self.lines: collections.deque[tuple[BatchRun, str]] = collections.deque()
            self.shown: dict[tuple[int, str], str] = {}
            self.quit_armed_until = 0.0
            self.interrupted = False

        def compose(self) -> ComposeResult:
            yield Header()
            with TabbedContent(id="tabs"):
                with TabPane("Summary", id="summary"):
                    yield DataTable(cursor_type="row", zebra_stripes=True)
                for pane_id, run in tabs.items():
                    with TabPane(self._label(run), id=pane_id):
                        yield RichLog(wrap=True, id=f"log-{pane_id}")
            yield Footer()

        def on_mount(self) -> None:
            table = self.query_one(DataTable)
            for column in COLUMNS:
                table.add_column(column, key=column)
            for i, _run in enumerate(runs):
                table.add_row(*[""] * len(COLUMNS), key=str(i))
            self._tick()
            self.set_interval(0.2, self._tick)
            threading.Thread(target=_execute_batch, daemon=True, args=(runs, stop),
                             kwargs={"on_line": lambda run, line: self.lines.append((run, line))}).start()

        @staticmethod
        def _label(run: BatchRun) -> str:
            return f"{ICONS[run.status]} {run.name.removesuffix('-deployment')}"

        def _task_text(self, run: BatchRun) -> str:
            if run.status == "skipped":
                return run.skip_reason or ""
            if run.status == "failed":
                return f"failed at: {run.failed_task}" if run.failed_task else f"exit code {run.code}"
            return run.task or "" if run.status == "running" else ""

        def _tick(self) -> None:
            """Show what the workers have produced, which they only ever add to a queue,
            so that a slow or closing UI can't hold up a run."""
            while self.lines:
                run, line = self.lines.popleft()
                pane_id = next(p for p, r in tabs.items() if r is run)
                log = self.query_one(f"#log-{pane_id}", RichLog)
                # Stay put if scrolled up to read something
                log.write(Text.from_ansi(line), scroll_end=log.is_vertical_scroll_end)
            table = self.query_one(DataTable)
            for i, run in enumerate(runs):
                values = {
                    "Deployment": Text(run.name.removesuffix("-deployment"), style="bold"),
                    "Status": Text(f"{ICONS[run.status]} {run.status}", style=STYLES[run.status]),
                    "Time": f"{run.elapsed:.0f}s" if run.started else "",
                    "Task": self._task_text(run),
                    "Recap": run.recap_text,
                }
                for column, value in values.items():
                    if self.shown.get((i, column)) != str(value):
                        self.shown[(i, column)] = str(value)
                        table.update_cell(str(i), column, value, update_width=True)
            for pane_id, run in tabs.items():
                if self.shown.get((-1, pane_id)) != run.status:
                    self.shown[(-1, pane_id)] = run.status
                    self.query_one(TabbedContent).get_tab(pane_id).label = self._label(run)
            counts = collections.Counter(run.status for run in runs)
            self.sub_title = " · ".join(f"{counts[s]} {s}" for s in ICONS if counts[s])
            if self.interrupted and all(run.settled for run in runs):
                self.exit(True)

        def on_tabbed_content_tab_activated(self, event: TabbedContent.TabActivated) -> None:
            widget = DataTable if event.pane.id == "summary" else RichLog
            event.pane.query_one(widget).focus()

        def on_data_table_row_selected(self, event: DataTable.RowSelected) -> None:
            pane_id = f"run-{event.row_key.value}"
            if pane_id in tabs:
                self.query_one(TabbedContent).active = pane_id

        def action_next_tab(self) -> None:
            self.query_one("#tabs Tabs", Tabs).action_next_tab()

        def action_previous_tab(self) -> None:
            self.query_one("#tabs Tabs", Tabs).action_previous_tab()

        def action_summary(self) -> None:
            self.query_one(TabbedContent).active = "summary"

        def action_drain(self) -> None:
            stop.set()
            self.notify("No more deployments will be started; those running will finish")

        async def action_quit(self) -> None:
            running = [run for run in runs if run.status == "running"]
            if all(run.settled for run in runs):
                self.exit(self.interrupted)
            elif self.interrupted:
                for run in running:
                    run.interrupt(signal.SIGTERM)
                self.notify(f"Sent SIGTERM to {len(running)} still running")
            elif time.monotonic() < self.quit_armed_until:
                self.interrupted = True
                stop.set()
                for run in running:
                    run.interrupt()
                self.notify(f"Interrupting {len(running)} deployment(s); will quit once they stop. Press q to force")
            else:
                self.quit_armed_until = time.monotonic() + QUIT_CONFIRM_SECONDS
                self.notify(f"{len(running)} still running: press q again to interrupt them", severity="warning")

    return BatchApp()


