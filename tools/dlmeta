def run_tui(target: str | None) -> None:
    from rich.text import Text
    from textual import work
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import Vertical
    from textual.screen import ModalScreen
    from textual.widgets import DataTable, Footer, Header, Input, Label, RichLog

    class Prompt(ModalScreen[str | None]):
        DEFAULT_CSS = "Prompt { align: center middle; } Prompt > Vertical { width: 70; height: auto; border: round $accent; padding: 1 2; background: $surface; }"
        BINDINGS = [Binding("escape", "cancel", "Cancel")]

        def __init__(self, question: str, value: str = "") -> None:
            super().__init__()
            self.question, self.value = question, value

        def compose(self) -> ComposeResult:
            with Vertical():
                yield Label(self.question)
                yield Input(value=self.value)

        def on_input_submitted(self, event: Input.Submitted) -> None:
            self.dismiss(event.value.strip() or None)

        def action_cancel(self) -> None:
            self.dismiss(None)

    COLUMNS = ["Deployment", "Local datalab", "Ansible rules", "Dirty", "Last run", "Deployed", "Live", "Maintenance"]

    class Dlmeta(App):
        TITLE = "datalab deployments"
        CSS = TABLE_CSS + "DataTable { height: 1fr; } RichLog { height: 9; border-top: solid $accent; }"
        BINDINGS = [
            Binding("j", "cursor_down", "Down", show=False),
            Binding("k", "cursor_up", "Up", show=False),
            Binding("t", "set_target", "Target"),
            Binding("b", "bump", "Bump"),
            Binding("d", "deploy", "Deploy"),
            Binding("D", "deploy_tags", "Run tags"),
            Binding("s", "shell", "Shell"),
            Binding("p", "probe", "Probe all"),
            Binding("i", "discover", "Discover URLs"),
            Binding("a", "toggle_inactive", "Show inactive"),
            Binding("o", "cycle_sort", "Sort"),
            Binding("r", "refresh", "Refresh"),
            Binding("q", "quit", "Quit"),
        ]

        def __init__(self) -> None:
            super().__init__()
            self.target = target
            self.show_inactive = False
            self.sort = "name"
            self.repos = {r.name: r for r in deployment_repos()}
            self.states: dict[str, dict] = {}
            self.tracks: dict = {}
            self.rules_tracks: dict = {}

        def compose(self) -> ComposeResult:
            yield Header()
            yield DataTable(cursor_type="row", zebra_stripes=True)
            yield RichLog(markup=True, wrap=True)
            yield Footer()

        def on_mount(self) -> None:
            table = self.query_one(DataTable)
            for col in COLUMNS:
                table.add_column(col, key=col)
            self._add_rows()
            self._update_subtitle()
            self.refresh_all()
            self.log_msg("[dim]t: set target version · b: bump submodule · d: deploy · D: run other tags · "
                         "s: shell in repo · p: probe live versions · i: discover API URLs (needs rbw)[/]")

        # helpers
        def _add_rows(self) -> None:
            table = self.query_one(DataTable)
            table.clear()
            for name in self.repos:
                table.add_row(*[""] * len(COLUMNS), key=name)
            for name in self.repos:
                if name in self.states:
                    self.render_row(name)

        def log_msg(self, msg: str) -> None:
            self.query_one(RichLog).write(msg)

        def _update_subtitle(self) -> None:
            target = f"target: {self.target}" if self.target else "no target set (press t)"
            self.sub_title = f"{target} · sorted by {self.sort}"

        def selected(self) -> str | None:
            table = self.query_one(DataTable)
            if table.row_count == 0:
                return None
            return table.coordinate_to_cell_key(table.cursor_coordinate).row_key.value

        def render_row(self, name: str) -> None:
            s = self.states[name]
            local = _version_text(s["local_version"], self.target, self.tracks)
            last_run = _last_run_text(s)
            live = _live_text(s, self.target, self.tracks)
            uncommitted = Text(str(len(s["uncommitted"])), style="yellow" if s["uncommitted"] else "green")
            note = f" ({s['inactive']})" if s["inactive"] else "" if s["vault_pass"] else " (no vault-pass)"
            name_text = Text(name.removesuffix("-deployment") + note, style="dim" if s["inactive"] or not s["vault_pass"] else "")
            values = [name_text, local, _rules_text(s, self.rules_tracks), uncommitted, last_run,
                      _version_text(s["deployed_version"], self.target, self.tracks), live, _age_text(s["last_maintenance"])]
            table = self.query_one(DataTable)
            for col, value in zip(COLUMNS, values):
                table.update_cell(name, col, value, update_width=True)

        @work(thread=True, exclusive=True, group="refresh")
        def refresh_all(self) -> None:
            self.tracks = latest_in_tracks(release_tags())
            self.rules_tracks = latest_in_tracks(release_tags("rules"), by_track=False)
            runs, probes = load_runs(), latest_probes()
            states = []
            for name, repo in self.repos.items():
                state = full_state(repo, runs, probes)
                states.append(state)
                self.call_from_thread(self._set_state, name, state)
            stale = stale_probe_targets(states)
            if stale:
                self.call_from_thread(self._probe, list(stale))

        def _set_state(self, name: str, state: dict) -> None:
            self.states[name] = state
            self.render_row(name)

        def refresh_one(self, name: str) -> None:
            self._set_state(name, full_state(self.repos[name]))

        def ensure_rbw(self) -> bool:
            if subprocess.run(["rbw", "unlocked"], capture_output=True).returncode == 0:
                return True
            with self.suspend():
                ok = subprocess.run(["rbw", "unlock"]).returncode == 0
            return ok

        # actions
        def action_cursor_down(self) -> None:
            self.query_one(DataTable).action_cursor_down()

        def action_cursor_up(self) -> None:
            self.query_one(DataTable).action_cursor_up()

        def action_refresh(self) -> None:
            self.refresh_all()

        def action_cycle_sort(self) -> None:
            keys = list(SORT_KEYS)
            self.sort = keys[(keys.index(self.sort) + 1) % len(keys)]
            if all(n in self.states for n in self.repos):
                ordered = sorted(self.repos, key=lambda n: SORT_KEYS[self.sort](self.states[n]))
                self.repos = {n: self.repos[n] for n in ordered}
                self._add_rows()
            self._update_subtitle()

        def action_toggle_inactive(self) -> None:
            self.show_inactive = not self.show_inactive
            self.repos = {r.name: r for r in deployment_repos(include_inactive=self.show_inactive)}
            self._add_rows()
            self.refresh_all()

        def action_set_target(self) -> None:
            def done(value: str | None) -> None:
                if value:
                    self.target = value
                    self._update_subtitle()
                    for name in self.states:
                        self.render_row(name)
            self.push_screen(Prompt("Target datalab version (git ref, e.g. v0.7.11):", self.target or ""), done)

        def action_bump(self) -> None:
            name = self.selected()
            if not name:
                return

            def done(ref: str | None) -> None:
                if ref:
                    self.target = self.target or ref
                    self._update_subtitle()
                    self.log_msg(f"{name}: checking out {ref} in src/datalab…")
                    self._bump(name, ref)
            self.push_screen(Prompt(f"Bump {name}'s datalab submodule to:", self.target or ""), done)

        @work(thread=True)
        def _bump(self, name: str, ref: str) -> None:
            result = bump(self.repos[name], ref)
            self.call_from_thread(self.log_msg, f"{name}: {result}")
            self.call_from_thread(self.refresh_one, name)

        def _run_in_repo(self, name: str, command: list[str]) -> None:
            with self.suspend():
                print(f"\n=== {name}: {' '.join(command)}\n", flush=True)
                code = subprocess.run(command, cwd=self.repos[name], env=_repo_env()).returncode
                if code != 0:
                    input(f"\n=== exited with {code}; press Enter to return to dlmeta ")
            self.refresh_one(name)
            self.log_msg(f"{name}: `{' '.join(command)}` exited with {code}")

        def action_deploy(self) -> None:
            name = self.selected()
            if name and self.ensure_rbw():
                self._run_in_repo(name, ["make", "deploy"])
                self._probe([name])

        def action_deploy_tags(self) -> None:
            name = self.selected()
            if not name:
                return

            def done(tags: str | None) -> None:
                if tags and self.ensure_rbw():
                    self._run_in_repo(name, ["make", *re.split(r"[\s,]+", tags)])
                    self._probe([name])
            self.push_screen(Prompt(f"Tags to run on {name} (space/comma separated, empty = cancel):", "maintenance deploy"), done)

        def action_shell(self) -> None:
            name = self.selected()
            if name:
                self._run_in_repo(name, [os.environ.get("SHELL", "zsh")])

        def action_probe(self) -> None:
            self._probe(list(self.repos))

        @work(thread=True, group="probe")
        def _probe(self, names: list[str]) -> None:
            targets = {n: self.states.get(n, {}).get("api_url") for n in names}
            with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
                futures = {pool.submit(probe_one, n, u): n for n, u in targets.items() if u}
                for future in concurrent.futures.as_completed(futures):
                    r = future.result()
                    self.call_from_thread(self.log_msg, f"{r['deployment']}: " + (
                        f"live {r['server_version']}" if r["ok"] else f"[dim]unreachable ({r['error']})[/]"))
                    self.call_from_thread(self.refresh_one, r["deployment"])

        def action_discover(self) -> None:
            if self.ensure_rbw():
                self.log_msg("discovering API URLs from inventories…")
                self._discover()

        @work(thread=True, exclusive=True, group="discover")
        def _discover(self) -> None:
            discover_all(list(self.repos.values()), lambda name, r: self.call_from_thread(
                self.log_msg, f"{name}: " + (f"[dim]{_discover_summary(r)}[/]" if "error" in r else _discover_summary(r))))
            self.call_from_thread(self.refresh_all)

    Dlmeta().run()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd")
    tui = sub.add_parser("tui")
    tui.add_argument("--to", help="target datalab version (git ref) to highlight and bump to")
    status = sub.add_parser("status")
    status.add_argument("--all", action="store_true", help="include inactive deployments")
    status.add_argument("--to", help="target datalab version (git ref) to highlight")
    status.add_argument("--no-probe", action="store_true",
                        help=f"don't re-probe deployments whose last probe is over {PROBE_MAX_AGE // 60} min old")
    status.add_argument("--sort", choices=list(SORT_KEYS), default="name",
                        help="row order; `maintenance` and `run` put the stalest first")
    status.set_defaults(func=cmd_status)
    run = sub.add_parser("run", help="run a command in several deployments, e.g. `dlmeta run -- make maintenance`")
    run.add_argument("--only", action="append", default=[], metavar="GLOB",
                     help="only these deployments (name or glob, without the -deployment suffix if you like; repeatable)")
    run.add_argument("--exclude", action="append", default=[], metavar="GLOB", help="leave out these deployments (repeatable)")
    run.add_argument("--all", action="store_true", help="include inactive deployments")
    run.add_argument("--rerun-after", type=_duration, metavar="DURATION",
                     help="skip deployments where these make targets succeeded more recently than this, e.g. 12h, 1d, 1w, "
                          "or 0 to always run (default: 1d for `make maintenance`, otherwise 0)")
    run.add_argument("--dry-run", "-n", action="store_true", help="show what would run")
    run.add_argument("--yes", "-y", action="store_true", help="don't ask for confirmation")
    run.add_argument("command", nargs=argparse.REMAINDER, help="the command, after `--`")
    run.set_defaults(func=cmd_run)
    sub.add_parser("discover").set_defaults(func=cmd_discover)
    sub.add_parser("probe").set_defaults(func=cmd_probe)
    dash = sub.add_parser("dashboard")
    dash.add_argument("--no-probe", action="store_true", help="use the last recorded probe results")
    dash.set_defaults(func=cmd_dashboard)
    args = parser.parse_args()
    RUNS.mkdir(parents=True, exist_ok=True)
    if args.cmd in (None, "tui"):
        run_tui(getattr(args, "to", None))
    else:
        args.func(args)


if __name__ == "__main__":
    sys.exit(main())
