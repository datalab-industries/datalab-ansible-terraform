# Use the terminal's own colours in the TUIs (or set TEXTUAL_THEME, e.g., to ansi-light)
os.environ.setdefault("TEXTUAL_THEME", "ansi-dark")
# Textual gives table headers a fixed bright blue background under those themes
TABLE_CSS = "DataTable:ansi > .datatable--header { background: ansi_default; }"

ROOT = Path(__file__).resolve().parent
CONFIG =Path(os.environ.get("DLMETA_CONFIG")
              or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "dlmeta" / "config.toml").expanduser()


def config() -> dict:
    return tomllib.loads(CONFIG.read_text()) if CONFIG.exists() else {}


STATE = Path(os.environ.get("DLMETA_STATE_DIR") or config().get("state_dir")
             or Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "dlmeta").expanduser()
RUNS = STATE / "runs"
LOGS = STATE / "logs"
PROBES = RUNS / "_probes.jsonl"
URLS = STATE / "deployments.json"
# Enabled for every command dlmeta runs in a deployment, so that the run is recorded in the ledger
LEDGER_PLUGIN = ROOT / "callback_plugins" / "deployment_ledger.py"
PROBE_TIMEOUT = 5
# Deployments that `dlmeta run` works on at a time
RUN_JOBS = 8
# `dlmeta run -- make maintenance` skips deployments that succeeded more recently than this (seconds)
MAINTENANCE_RERUN_AFTER = 24 * 3600
# Per-repo limit for decrypting an inventory during `discover`
DISCOVER_TIMEOUT = 30
# `status` and the TUI re-probe deployments whose last probe is older than this (seconds)
PROBE_MAX_AGE = 15 * 60
# Release tags are tracked for the datalab submodule and the ansible-terraform rules submodule:
# kind -> (upstream remote, submodule path, tag cache, config section of flagged versions)
SOURCES = {
    "datalab": ("https://github.com/datalab-org/datalab", "src/datalab", RUNS / "_tags.json", "flagged"),
    "rules": ("https://github.com/datalab-industries/datalab-ansible-terraform", "src/datalab-ansible-terraform",
              RUNS / "_rules_tags.json", "flagged_rules"),
}
TAGS_MAX_AGE = 3600
# Last runs/maintenance younger than these (days) are shown green, then yellow, then red
AGE_OK_DAYS, AGE_WARN_DAYS = 30, 90
# Runs with these tags count as maintenance (package upgrades, incl. Docker, only run under the
# `maintenance` tag or a whole-playbook run, recorded with tags ["all"])
MAINTENANCE_TAGS = {"all", "maintenance"}
SORT_KEYS = {
    "name": lambda r: r["deployment"],
    # never-maintained first, then oldest maintenance first
    "maintenance": lambda r: r["last_maintenance"] or "",
    "run": lambda r: r["last_run"] or "",
}


def _now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def _read_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


def _git(repo: Path, *args: str) -> str | None:
    try:
        return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True,
                              check=True, timeout=30).stdout.strip()
    except (subprocess.SubprocessError, OSError):
        return None


def _repo_env() -> dict[str, str]:
    """Environment for commands run inside a deployment repo."""
    # dlmeta itself runs in a uv script environment, whose VIRTUAL_ENV would otherwise make
    # `uv run` look for ansible there rather than in the deployment repo's own .venv
    env = {k: v for k, v in os.environ.items() if k != "VIRTUAL_ENV" and not k.startswith("UV_")}
    if venv := os.environ.get("VIRTUAL_ENV"):
        env["PATH"] = os.pathsep.join(p for p in env.get("PATH", "").split(os.pathsep) if p != str(Path(venv) / "bin"))
    # The callback otherwise writes next to wherever it is installed
    env["DEPLOYMENT_LEDGER_DIR"] = str(RUNS)
    if LEDGER_PLUGIN.is_file():
        env["ANSIBLE_CALLBACK_PLUGINS"] = os.pathsep.join(
            filter(None, (str(LEDGER_PLUGIN.parent), env.get("ANSIBLE_CALLBACK_PLUGINS"))))
        env["ANSIBLE_CALLBACKS_ENABLED"] = ",".join(
            filter(None, (LEDGER_PLUGIN.stem, env.get("ANSIBLE_CALLBACKS_ENABLED"))))
    return env


def ensure_rbw() -> None:
    if shutil.which("rbw") and subprocess.run(["rbw", "unlocked"], capture_output=True).returncode != 0:
        subprocess.run(["rbw", "unlock"])


# --- Local repo state --------------------------------------------------------------------


def inactive() -> dict[str, str]:
    """Deployment name -> reason, for deployments marked inactive in the config."""
    return config().get("inactive", {})


def _is_deployment(path: Path) -> bool:
    return (path / "ansible" / "playbook.yml").is_file()


def deployment_roots() -> list[Path]:
    """The configured locations of deployments, each either a repo or a folder of repos."""
    override = os.environ.get("DLMETA_DEPLOYMENTS_DIR")
    roots = [override] if override else config().get("deployments", ["~/repos/datalab/deployments"])
    return [Path(root).expanduser() for root in roots]


@functools.cache
def _warn_once(message: str) -> None:
    print(f"dlmeta: {message}", file=sys.stderr)


def deployment_repos(include_inactive: bool = False) -> list[Path]:
    hidden = {} if include_inactive else inactive()
    repos: dict[str, Path] = {}
    for root in deployment_roots():
        if not root.is_dir():
            _warn_once(f"configured deployment location {root} does not exist")
            continue
        for path in [root] if _is_deployment(root) else sorted(root.iterdir()):
            if not _is_deployment(path) or path.name in hidden:
                continue
            # The ledger, probes and URLs are all keyed by the repo's folder name
            if path.name in repos and repos[path.name].resolve() != path.resolve():
                _warn_once(f"ignoring {path}, {repos[path.name]} has the same name")
                continue
            repos[path.name] = path
    return sorted(repos.values(), key=lambda path: path.name)


def _matches(name: str, patterns: list[str]) -> bool:
    return any(fnmatch.fnmatchcase(n, p) for p in patterns for n in (name, name.removesuffix("-deployment")))


def select_repos(only: list[str], exclude: list[str], include_inactive: bool = False) -> list[Path]:
    """Filter deployments by name or glob, with or without the -deployment suffix.

    A pattern that matches nothing is an error, as a mistyped exclusion would otherwise
    run the command on the deployment that was meant to be left out.
    """
    known = deployment_repos(include_inactive=True)
    for pattern in [*only, *exclude]:
        if not any(_matches(r.name, [pattern]) for r in known):
            sys.exit(f"dlmeta: no deployment matches {pattern!r}")
    return [r for r in deployment_repos(include_inactive)
            if (not only or _matches(r.name, only)) and not _matches(r.name, exclude)]


def local_state(repo: Path) -> dict:
    submodule = repo / "src" / "datalab"
    rules = repo / "src" / "datalab-ansible-terraform"
    status = _git(repo, "status", "--porcelain") or ""
    # sync-ansible-upstream.sh copies rules/ansible over ansible/ (except vaults and the inventory)
    # without deleting anything, so files only present locally (leftovers, group_vars) are expected;
    # changed files, or upstream files missing locally, mean local changes that are not upstream
    rules_differ = None
    if (rules / "ansible").is_dir():
        diff = subprocess.run(
            ["diff", "-rq", "--exclude=vaults", "--exclude=inventory.yml", "--exclude=__pycache__",
             str(rules / "ansible"), str(repo / "ansible")], capture_output=True, text=True).stdout
        rules_differ = any(not line.startswith(f"Only in {repo / 'ansible'}") for line in diff.splitlines())
    return {
        "deployment": repo.name,
        "path": str(repo),
        "local_version": _git(submodule, "describe", "--tags", "--match", "v*"),
        "local_commit": (_git(submodule, "rev-parse", "HEAD") or "")[:8],
        "ansible_version": _git(rules, "describe", "--tags", "--dirty") if rules.is_dir() else None,
        "ansible_local_changes": rules_differ,
        "uncommitted": [line[3:] for line in status.splitlines()],
        "vault_pass": (repo / ".vault-pass.sh").is_file(),
        "makefile": (repo / "Makefile").is_file(),
        "inactive": inactive().get(repo.name),
    }


def bump(repo: Path, ref: str) -> str:
    """Check out `ref` in the repo's datalab submodule, fetching tags first."""
    submodule = repo / "src" / "datalab"
    fetch = subprocess.run(["git", "-C", str(submodule), "fetch", "--tags", "--quiet", "origin"],
                           capture_output=True, text=True, timeout=120)
    checkout = subprocess.run(["git", "-C", str(submodule), "checkout", "--quiet", ref],
                              capture_output=True, text=True, timeout=60)
    if checkout.returncode != 0:
        return f"failed: {(checkout.stderr or fetch.stderr).strip().splitlines()[-1] if (checkout.stderr or fetch.stderr).strip() else 'unknown error'}"
    note = " (fetch failed, used local tags)" if fetch.returncode != 0 else ""
    return f"now at {_git(submodule, 'describe', '--tags', '--match', 'v*')}{note}"


# --- Ledger ------------------------------------------------------------------------------


def load_runs() -> dict[str, list[dict]]:
    """Merge start/finish records into one dict per run, oldest first, per deployment."""
    deployments = {}
    for path in sorted(RUNS.glob("*.jsonl")):
        if path.name.startswith("_"):
            continue
        runs: dict[str, dict] = {}
        for record in _read_jsonl(path):
            run = runs.setdefault(record["run_id"], {"status": "incomplete"})
            if record["event"] == "start":
                run.update(record, started=record["time"])
            else:
                run.update(status=record["status"], finished=record["time"],
                           stats=record.get("stats", {}), hosts=record.get("hosts", {}))
        deployments[path.stem] = sorted(runs.values(), key=lambda r: r.get("started", ""))
    return deployments


def ledger_summary(runs: list[dict]) -> dict:
    last = runs[-1] if runs else {}
    successful = [r for r in runs if r["status"] == "success"]
    last_ok = successful[-1] if successful else {}
    deploys = [r for r in successful if {"deploy", "all", "setup"} & set(r.get("tags") or ["all"])]
    maintenance = [r for r in successful if MAINTENANCE_TAGS & set(r.get("tags") or ["all"])]
    return {
        "last_run": last.get("started"),
        "last_run_status": last.get("status"),
        "last_run_tags": ",".join(last.get("tags") or []),
        "last_success": last_ok.get("started"),
        "deployed_version": deploys[-1].get("datalab_version") if deploys else None,
        "last_deploy": deploys[-1]["started"] if deploys else None,
        "last_maintenance": maintenance[-1]["started"] if maintenance else None,
        "commit": (last_ok.get("commit") or "")[:8],
        "dirty_files": last_ok.get("dirty_files") or [],
        "hosts": {h: i for r in successful for h, i in (r.get("hosts") or {}).items()},
    }


# --- Discovery and probing ---------------------------------------------------------------


def load_urls() -> dict[str, dict]:
    return json.loads(URLS.read_text()) if URLS.exists() else {}


def discover(repo: Path) -> dict:
    """Read api_url/app_url for each host from the repo's (vault-encrypted) inventory."""
    if not (repo / ".vault-pass.sh").is_file():
        return {"error": "no .vault-pass.sh"}
    venv_bin = repo / ".venv" / "bin" / "ansible-inventory"
    command = [str(venv_bin)] if venv_bin.is_file() else ["uv", "run", "ansible-inventory"]
    # No stdin: .vault-pass.sh falls back to `read`-ing a password when rbw has no entry, which
    # would otherwise wait invisibly on the terminal
    try:
        proc = subprocess.run(
            [*command, "-i", "ansible/inventory.yml", "--list", "--vault-password-file=./.vault-pass.sh"],
            cwd=repo, env=_repo_env(), stdin=subprocess.DEVNULL, capture_output=True, text=True,
            timeout=DISCOVER_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        return {"error": f"timed out after {DISCOVER_TIMEOUT}s"}
    if proc.returncode != 0:
        if any(m in proc.stderr for m in ("Decryption failed", "Invalid vault password", "no vault secrets")):
            return {"error": "could not decrypt the inventory (no rbw entry for this repo?)"}
        return {"error": (proc.stderr.strip().splitlines() or ["ansible-inventory failed"])[-1][:200]}
    hostvars = json.loads(proc.stdout).get("_meta", {}).get("hostvars", {})
    hosts = {h: {k: v[k] for k in ("api_url", "app_url") if isinstance(v.get(k), str)} for h, v in hostvars.items()}
    return {"hosts": hosts, "discovered": _now()}


def save_discovered(results: dict[str, dict]) -> None:
    urls = load_urls()
    for name, result in results.items():
        if "hosts" in result:
            urls[name] = result
    URLS.write_text(json.dumps(urls, indent=2, sort_keys=True) + "\n")


def api_url_for(name: str, ledger: dict | None = None) -> str | None:
    hosts = (load_urls().get(name) or {}).get("hosts") or (ledger or {}).get("hosts") or {}
    urls = sorted(i["api_url"] for i in hosts.values() if i.get("api_url"))
    return urls[-1] if urls else None


def probe_one(name: str, api_url: str) -> dict:
    url = (api_url if "://" in api_url else f"https://{api_url}").rstrip("/") + "/info"
    record = {"deployment": name, "time": _now(), "url": url}
    try:
        with urllib.request.urlopen(url, timeout=PROBE_TIMEOUT) as resp:
            record.update(ok=True, server_version=json.load(resp)["meta"]["server_version"])
    except Exception as exc:
        record.update(ok=False, error=f"{type(exc).__name__}: {exc}"[:200])
    with PROBES.open("a") as out:
        out.write(json.dumps(record, sort_keys=True) + "\n")
    return record


def latest_probes() -> dict[str, dict]:
    return {r["deployment"]: r for r in _read_jsonl(PROBES)}


def release_tags(kind: str = "datalab", refresh: bool = False) -> list[str]:
    """Release tags for `kind` (see SOURCES), from the upstream remote (cached for an hour),
    else from the local submodules."""
    remote, submodule, cache, _ = SOURCES[kind]
    if not refresh and cache.exists():
        cached = json.loads(cache.read_text())
        age = datetime.datetime.now(datetime.timezone.utc) - datetime.datetime.fromisoformat(cached["time"])
        if age.total_seconds() < TAGS_MAX_AGE:
            return cached["tags"]
    try:
        out = subprocess.run(["git", "ls-remote", "--tags", "--refs", remote, "v*"],
                             capture_output=True, text=True, check=True, timeout=15).stdout
        tags = sorted({line.rsplit("refs/tags/", 1)[-1] for line in out.splitlines()})
        RUNS.mkdir(exist_ok=True)
        cache.write_text(json.dumps({"time": _now(), "tags": tags}))
        return tags
    except (subprocess.SubprocessError, OSError):
        if cache.exists():
            return json.loads(cache.read_text())["tags"]
        tags = set()
        for repo in deployment_repos(include_inactive=True):
            tags.update((_git(repo / submodule, "tag", "--list", "v*") or "").split())
        return sorted(tags)


def _parse(version: str):
    from packaging.version import InvalidVersion, Version

    try:
        return Version(_normalise(version))
    except InvalidVersion:
        return None


def latest_in_tracks(tags: list[str], by_track: bool = True) -> dict[tuple, object]:
    """Newest version per major.minor track (pre-releases included, e.g. 0.8.0a1 for 0.8), or
    with by_track=False a single newest version (key ()) for repos without maintained release lines."""
    latest: dict[tuple, object] = {}
    for tag in tags:
        v = _parse(tag)
        if v is not None:
            track = v.release[:2] if by_track else ()
            if track not in latest or v > latest[track]:
                latest[track] = v
    return latest


def flagged_reason(version: str, kind: str = "datalab") -> str | None:
    """Reason from the config's [flagged] (or [flagged_rules]) if `version` matches one of its specifiers."""
    from packaging.specifiers import InvalidSpecifier, SpecifierSet

    v = _parse(version)
    if v is None:
        return None
    for spec, reason in config().get(SOURCES[kind][3], {}).items():
        try:
            if SpecifierSet(spec).contains(v, prereleases=True):
                return reason
        except InvalidSpecifier:
            if _normalise(spec) == _normalise(version):
                return reason
    return None


def version_verdict(version: str | None, target: str | None, tracks: dict,
                    kind: str = "datalab") -> tuple[str, str | None]:
    """(rich style, note) for a version: flagged > target match > latest in its track."""
    if not version:
        return "dim", None
    reason = flagged_reason(version, kind)
    if reason:
        return "bold red", reason
    if target:
        return ("green", None) if _normalise(version) == _normalise(target) else ("yellow", f"not {target}")
    v = _parse(version)
    latest = (tracks.get(v.release[:2]) or tracks.get(())) if v is not None else None
    if latest is None:
        return "", None
    return ("green", None) if v >= latest else ("yellow", f"{latest} available")


def _canonical(version: str) -> str:
    """Turn the forms servers report back into `git describe` form, e.g.
    0.8.0+alpha.1.6.gae3c005a -> 0.8.0-alpha.1-6-gae3c005a and 0.7.5+66.g7531edb2 -> 0.7.5-66-g7531edb2."""
    m = re.fullmatch(r"v?(\d+(?:\.\d+)*)\+(.+)", version)
    if not m:
        return version
    local = re.sub(r"\.(\d+)\.g([0-9a-f]+)$", r"-\1-g\2", m[2])
    local = re.sub(r"^(\d+)\.g([0-9a-f]+)$", r"\1-g\2", local)
    return f"{m[1]}-{local}"


def _normalise(version: str) -> str:
    """Rough match between `git describe` (v0.8.0-alpha.1-6-gae3c005a) and PEP 440 versions."""
    v = _canonical(version).lstrip("v").replace("-alpha.", "a").replace("-beta.", "b").replace("-rc.", "rc").replace("-rc", "rc")
    return v.split("+")[0].split("-")[0].split(".dev")[0]


def full_state(repo: Path, runs: dict | None = None, probes: dict | None = None) -> dict:
    runs = load_runs() if runs is None else runs
    probes = latest_probes() if probes is None else probes
    state = local_state(repo)
    ledger = ledger_summary(runs.get(repo.name, []))
    probe = probes.get(repo.name)
    state.update(ledger)
    state["api_url"] = api_url_for(repo.name, ledger)
    state["live_version"] = probe.get("server_version") if probe and probe.get("ok") else None
    state["probe_error"] = probe.get("error") if probe and not probe.get("ok") else None
    state["probe_time"] = probe.get("time") if probe else None
    return state


# --- CLI commands ------------------------------------------------------------------------


def discover_all(repos: list[Path], report) -> dict[str, dict]:
    """Run `discover` for each repo in parallel, calling report(name, result) as each finishes."""
    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        futures = {pool.submit(discover, repo): repo.name for repo in repos}
        for future in concurrent.futures.as_completed(futures):
            name = futures[future]
            results[name] = future.result()
            report(name, results[name])
    save_discovered(results)
    return results


def _discover_summary(result: dict) -> str:
    if "error" in result:
        return f"skipped: {result['error']}"
    return ", ".join(filter(None, (i.get("api_url") for i in result["hosts"].values()))) or "no api_url"


def cmd_discover(_args) -> None:
    subprocess.run(["rbw", "unlocked"], capture_output=True).returncode == 0 or subprocess.run(["rbw", "unlock"])
    discover_all(deployment_repos(), lambda name, r: print(f"{name}: {_discover_summary(r)}", flush=True))


def stale_probe_targets(states: list[dict]) -> dict[str, str]:
    """Deployments with a known api_url whose last probe is missing or older than PROBE_MAX_AGE."""
    now = datetime.datetime.now(datetime.timezone.utc)
    return {
        s["deployment"]: s["api_url"] for s in states
        if s["api_url"] and (not s["probe_time"] or
                             (now - datetime.datetime.fromisoformat(s["probe_time"])).total_seconds() > PROBE_MAX_AGE)
    }


def probe_many(targets: dict[str, str], report=lambda r: None) -> None:
    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
        for future in concurrent.futures.as_completed([pool.submit(probe_one, n, u) for n, u in targets.items()]):
            report(future.result())


def _live_text(state: dict, target: str | None, tracks: dict):
    from rich.text import Text

    if state["live_version"]:
        text = _version_text(state["live_version"], target, tracks)
    elif state["probe_error"]:
        text = Text("unreachable", style="dim")
    elif not state["api_url"]:
        return Text("no URL", style="dim")
    else:
        text = Text("not probed", style="dim")
    return text


def cmd_probe(_args) -> None:
    runs = load_runs()
    targets = {r.name: api_url_for(r.name, ledger_summary(runs.get(r.name, []))) for r in deployment_repos()}
    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
        futures = {pool.submit(probe_one, n, u): n for n, u in targets.items() if u}
        for future in concurrent.futures.as_completed(futures):
            r = future.result()
            print(f"{r['deployment']}: {r.get('server_version') or 'unreachable (' + r['error'] + ')'}")
    for name, url in targets.items():
        if not url:
            print(f"{name}: no api_url known (run `dlmeta discover`)")


def _short(version: str) -> str:
    """v0.8.0-alpha.1-6-gae3c005a -> 0.8.0-alpha.1 +6"""
    version = _canonical(version)
    dirty = version.endswith("-dirty")
    m = re.fullmatch(r"v?(.*?)(?:-(\d+)-g[0-9a-f]+)?", version.removesuffix("-dirty"))
    short = f"{m[1]} +{m[2]}" if m and m[2] else (m[1] if m else version)
    return short + (" (uncommitted)" if dirty else "")


def _version_text(version: str | None, target: str | None, tracks: dict | None = None,
                  kind: str = "datalab"):
    from rich.text import Text

    if not version:
        return Text("–", style="dim")
    style, reason = version_verdict(version, target, tracks or {}, kind)
    text = Text(_short(version), style=style)
    if style == "bold red":
        text = Text("⚠ ", style=style) + text
    return text


def _age_text(ts: str | None, suffix: str = ""):
    from rich.text import Text

    if not ts:
        return Text("no record", style="red")
    days = (datetime.datetime.now(datetime.timezone.utc) - datetime.datetime.fromisoformat(ts)).days
    style = "green" if days <= AGE_OK_DAYS else "yellow" if days <= AGE_WARN_DAYS else "red"
    return Text(_ago(ts) + suffix, style=style)


def _last_run_text(state: dict):
    from rich.text import Text

    if not state["last_run_status"]:
        return Text("no record", style="red")
    dot = {"success": "green", "failed": "bold red", "incomplete": "yellow"}.get(state["last_run_status"], "")
    text = Text("● ", style=dot) + _age_text(state["last_run"])
    if state["last_run_tags"]:
        text.append(f" {state['last_run_tags']}", style="dim")
    return text


def _rules_text(state: dict, tracks: dict | None = None):
